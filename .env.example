# ─── Required ────────────────────────────────────────────────────────────────

# Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase project: Connect → ORMs → Drizzle. Use the transaction pooler (port 6543) for the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct or session connection (port 5432) for running migrations. Optional; falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Access ──────────────────────────────────────────────────────────────────

# Comma-separated Google emails allowed to sign in. Leave empty to allow ANY Google account.
ALLOWED_EMAILS=you@example.com,friend@example.com

# Comma-separated admins. Always allowed to sign in; can manage invites and players on their own profile.
ADMIN_EMAILS=you@example.com

# Shown on /privacy and /terms as the address for questions and deletion requests.
CONTACT_EMAIL=you@example.com

# ─── Optional: cameras and voice in online rooms (LiveKit) ───────────────────
# Leave unset to play online without video. Also signs the phone camera links.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Optional: only for re-recording the caller (pnpm caller:generate) ───────
ELEVENLABS_API_KEY=
