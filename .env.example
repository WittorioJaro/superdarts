# Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase project: Connect → ORMs → Drizzle. Use the transaction pooler (port 6543) for the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct or session connection (port 5432) for running migrations. Optional; falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated Google emails allowed to sign in. Leave empty to allow anyone.
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
